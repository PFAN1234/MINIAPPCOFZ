# Segredos do SERVIDOR (referência). Nunca vão para o cliente nem para o Git.
# Ficam somente nos segredos das Edge Functions do Supabase
# (Dashboard > Edge Functions > Secrets, ou `supabase secrets set`).
# O cliente (app/) usa apenas a chave publicável: ver app/.env.example.
TELEGRAM_BOT_TOKEN=
SUPABASE_SECRET_KEY=
