# Copie para .env.local (ignorado pelo Git) e preencha para desenvolvimento local.
# A chave publicável (publishable key) do Supabase é pública por projeto: pode ir
# no bundle do cliente, pois quem protege os dados é o RLS. Mesmo assim, os valores
# reais ficam nas variáveis de ambiente da Vercel ou em .env.local, não neste arquivo.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Dados de teste (sem Supabase): descomente para usar a fixture da HTO.
# VITE_DADOS=fixture

# Site de administração (/admin/): nome do bot (sem @) para o Telegram Login Widget.
# O domínio do site precisa estar no bot (/setdomain no BotFather). Ver docs/admin.md.
VITE_TELEGRAM_BOT=

# QR da realidade aumentada (admin): nome curto do Mini App no BotFather (o <app> de
# https://t.me/<bot>/<app>?startapp=...). Padrão: fiscalcofz. O <bot> vem de VITE_TELEGRAM_BOT.
# VITE_TELEGRAM_APP=fiscalcofz

# Gerador do boletim (funções da Vercel em api/; só no servidor, NUNCA com prefixo VITE_).
# URL do projeto e chave secreta (sb_secret_..., ou a service_role antiga) do Supabase.
# Na Vercel: Settings → Environment Variables, só em Production (e Preview, se for testar lá).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Opcional, local: executável do Chromium (sem ele, o do `npx playwright install chromium`).
# PW_CHROMIUM=/opt/pw-browsers/chromium-1243/chrome-linux64/chrome
