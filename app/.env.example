# Copie para .env.local (ignorado pelo Git) e preencha para desenvolvimento local.
# A chave publicável (publishable key) do Supabase é pública por projeto: pode ir
# no bundle do cliente, pois quem protege os dados é o RLS. Mesmo assim, os valores
# reais ficam nas variáveis de ambiente da Vercel ou em .env.local, não neste arquivo.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
